#!/bin/sh
# AIGenerator pre-push hook: nothing goes up with a secret or with the basics broken. Enable it once per clone:
#     git config core.hooksPath .githooks
# For each branch being pushed, on the commits the remote does not have yet (each one read on its own):
# 1. looks for secrets (bin/check_secrets.py);
# 2. on a copy of the pushed commit's tree (not the working folder): the syntax of every .py, tests/test_contract.py
#    (which also checks the local .aigen-denylist list, AGENTS.md) and tests/test_pure.py. None of them needs torch
#    or a GPU, and none generates an image: seconds.
# Any failure blocks the push. Without a Python 3.11+ on the PATH, it warns that it did not run and lets the push
# through. Do not bypass it with --no-verify: fix it and push again.
set -u
remote="${1:-origin}"
root="$(git rev-parse --show-toplevel)" || exit 1
cd "$root" || exit 1

py=""
for c in python3 python; do
    if command -v "$c" >/dev/null 2>&1 && "$c" -c "import sys; sys.exit(sys.version_info < (3, 11))" </dev/null >/dev/null 2>&1; then
        py="$c"
        break
    fi
done
if [ -z "$py" ]; then
    echo "pre-push: WARNING: Python 3.11+ not found on the PATH; the check (secrets and tests) did NOT run." >&2
    exit 0
fi

failed=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "${local_sha:-}" ] && continue
    case "$local_sha" in *[!0]*) ;; *) continue ;; esac  # deleting a branch: nothing to check
    echo "pre-push: $local_ref -> $remote ($remote_ref)"
    "$py" bin/check_secrets.py --revs "$local_sha --not --remotes=$remote" </dev/null || failed=1
    tree="$(mktemp -d 2>/dev/null || echo "${TMPDIR:-/tmp}/aigen_pre_push_$$")"
    mkdir -p "$tree"
    if git archive "$local_sha" </dev/null | tar -x -C "$tree"; then
        ( cd "$tree" && git -C "$root" ls-tree -r -z --name-only "$local_sha" | "$py" -c '
import os, sys
errors = 0
for c in sys.stdin.buffer.read().split(b"\0"):
    name = c.decode("utf-8", "surrogateescape")
    if not name.endswith(".py") or not os.path.isfile(name):
        continue
    try:
        compile(open(name, "rb").read(), name, "exec")
    except (SyntaxError, ValueError) as e:
        print("  syntax error: %s: %s" % (name, e))
        errors += 1
sys.exit(1 if errors else 0)
' ) || failed=1
        for test in test_contract.py test_pure.py; do
            [ -f "$tree/tests/$test" ] || continue  # an old commit, without the test, is skipped quietly
            AIGEN_GIT_ROOT="$root" AIGEN_REV="$local_sha" "$py" "$tree/tests/$test" \
                </dev/null >"$tree.log" 2>&1 || { tail -n 30 "$tree.log"; failed=1; }
        done
    else
        echo "pre-push: could not copy the tree of $local_sha" >&2
        failed=1
    fi
    rm -rf "$tree" "$tree.log"
done

if [ "$failed" -ne 0 ]; then
    echo "pre-push: BLOCKED. Fix it and push again (do not use --no-verify)." >&2
    exit 1
fi
echo "pre-push: ok"
